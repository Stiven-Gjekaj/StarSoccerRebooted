// The squad of a club, or the top scorers of a league. A screen of the
// remake. The code fills the list "PlayerList" from the templates
// "PlayerEntry" and "RivalEntry". Each row has the texts 1 to 7: the
// position, the name, the age, the skill, the matches, the goals, and the
// assists.

UnsortedLayer:(AfterGloss,1)

Import:(ButtonDefs.uis)
Import:(ButtonMacros.uis)
Import:(JDButtonDefs.uis)
Import:(JDButtonMacros.uis)

Rect:(0,0,0,0)
	ShowShell(Ticker,1)
	SetTweak(Menu,StarBuxButtonEnabled,1)

M_Background:()
M_Footer:(OFF,,,)

// The ribbon at the top: the quit button, the Bux, and the help.
Rect:()
	ShowIf(Menu,DisableQuitButton,0)
{
	M_Header:(-40,@T,ILife,32,36,88,198,14)
	Import:(quitmenu.uih)
}
Rect:()
	ShowIf(Menu,DisableQuitButton,1)
{
	M_Header:(-40,@T,ILife,32,36,88,198,14,YES)
}

// The top of the buttons at the bottom.
Set:(@n=[@B-960]*0.7+744)

// The title: the name of the club or of the league, in the middle just
// above the list.
PushOrigin:(60,128)
	Rect:(0,0,500,76)
	{
		Draw:(ButtonShadow,18,8,500,76,,#FFFFFF80)
		Draw:(GreenButton,10,0,500,76)
		Draw:(Glint,0,15.5,42,,,#606060FFFFFFFFFF)
			Handle(42,16)
			Shine(0,480)
			Additive()
		Text:(Squad,20,0,480,72)
			FontSize(1)
			Layer(AfterGloss)
			StringReadout(Squad,Title)
	}
		ConvergeFrom(-640,0)
PopOrigin

// A row of the list.
Macro:(M_PlayerRow,?REF?,?COLOR?)
	Draw:(GreyRecess,0,0,562,52) ref:?REF?
	{
		Draw:(GreyRecess,3,3,555,46,,?COLOR?)
			Additive()
		Draw:(White,6,7,52,40,,#30303070)
			Additive()
		Draw:(White,368,7,44,40,,#30303070)
			Additive()
		Draw:(White,460,7,44,40,,#30303070)
			Additive()
		Text:(POS,6,5,52,44,C,,#BBDDBBFF) ref:?REF?
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.45,0.45)
		Text:(NAME,66,5,252,44,L,,#80BB80FF) ref:?REF?
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.4,0.4)
		Text:("00",322,5,44,44,C,,#BBDDBBFF) ref:?REF?
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.5,0.5)
		Text:("00",368,5,44,44,C,,#80BB80FF) ref:?REF?
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.5,0.5)
		Text:("00",414,5,44,44,C,,#BBDDBBFF) ref:?REF?
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.5,0.5)
		Text:("00",460,5,44,44,C,,#80BB80FF) ref:?REF?
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.5,0.5)
		Text:("00",506,5,44,44,C,,#BBDDBBFF) ref:?REF?
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.5,0.5)
		Draw:(ScrollFade,-1,-2,561,30,,#FFFFFF70)
	} Template
EndM

// The list.
PushOrigin:(13,210)
	Draw:(GreyRecess,0,0,614,516)
		SwipePanel(Squad,Scroll,Squad,ScrollVel)
	{
		PushOrigin:(7,8)
			M_BGScrollWindow:(599,502)
		PopOrigin()

		Clip:(4,14,611,451)
			Handle(0,-46)
		{
			M_PlayerRow:(PlayerEntry,#30303000)
			M_PlayerRow:(RivalEntry,#7D8FEBFF)

			Rect:(0,0,0,0) ref:PlayerList
				ScrollingList(Squad,Scroll,496,Squad,ScrollVel) ref:ScrollingList
			{
			}
		}
		PushOrigin:(2,-1)
			Draw:(GreyRecess,579,16,22,490)
			{
				Draw:(SliderButton,581,16,20,490,,#656565FF)
					ScrollIndicator(PlayerList,ScrollingList)
			}
		PopOrigin

		Draw:(ScrollFade,2,1,611,60,0,#000000FF)
			Layer(AfterGloss)
	}
		ConvergeFrom(-640,0)
PopOrigin

// The names of the columns.
PushOrigin:(22,220)
	Rect:(0,0)
	{
		Draw:(ScrollFade,-3,40,574,60,0,#000000FF)
			Layer(AfterGloss)
		Draw:(GreyReadout,-2,0,568,52,,#EEFFEEFF)
			Layer(AfterGloss)
		Text:(Pos,6,5,52,44,C,,#FFFFFFFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.4,0.4)
		Text:(Name,66,5,252,44,L,,#FFFFFFFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.4,0.4)
		Text:(Age,322,5,44,44,C,,#FFFFFFFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.4,0.4)
		Text:(SKL,368,5,44,44,C,,#FFFFFFFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.4,0.4)
		Text:(P,414,5,44,44,C,,#FFFFFFFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.4,0.4)
		Text:(G,460,5,44,44,C,,#FFFFFFFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.4,0.4)
		Text:(A,506,5,44,44,C,,#FFFFFFFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.4,0.4)
	}
		ConvergeFrom(-640,0)
PopOrigin

// Back to the league.
PushOrigin:(12,@n)
	M_NavButton:(0,0,navigate_Back,,)
	{
		Draw:(IBack,28,30,90,90)
	}
		Delay(0.2)
		ConvergeFrom(-640,0)
		Click(squad.btn_Back)
		<
			PlaySnd(UISelect)
		>
PopOrigin

// The squad, or the top scorers of the league.
PushOrigin:(168,@n)
	M_NavButton:(0,0,,,)
	{
		Draw:(IStats,27,22,96,)
		Text:(Scorers,0,104,146,60,C,C)
			FontSize(1)
			FontScale(0.45,0.45)
			StringReadout(Squad,ModeText)
	}
		Delay(0.1)
		ConvergeFrom(-640,0)
		Click(squad.btn_Mode)
		<
			PlaySnd(UISelect)
		>
PopOrigin

// The champions and the top scorers of the past seasons.
PushOrigin:(324,@n)
	M_NavButton:(0,0,SSR_Honours,,)
	{
		Draw:(ICup,30,25,90,90)
	}
		Delay(0.15)
		ConvergeFrom(-640,0)
		Click(squad.btn_Honours)
		<
			PlaySnd(UISelect)
		>
PopOrigin
