# The commentary of a match gets the height that is free on a tall screen
# (Match, CommentaryExtra). The game sets it from the top of the screen.
# The macro calls become their lines, because a macro argument cannot hold
# the comma of twk().
- M_ResizeWithScreen:(614,514,614,627)
+ DoIf(Match,MaximiseScreen,0)
+ <
+     ConvergeSizeTo(614,514+twk(Match,CommentaryExtra))
+ >
+ DoIf(Match,MaximiseScreen,1)
+ <
+     ConvergeSizeTo(614,627+twk(Match,CommentaryExtra))
+ >
