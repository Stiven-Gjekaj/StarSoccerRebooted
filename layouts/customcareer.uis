// Back to the nation.
PushOrigin:(12,@n)
	M_NavButton:(0,0,navigate_Back,,)
	{
		Draw:(IBack,28,30,90,90)
	}
		Delay(0.2)
		ConvergeFrom(-640,0)
		Click(customcareer.btn_Back)
		<
			PlaySnd(UISelect)
		>
PopOrigin

// On to the trials.
PushOrigin:(480,@n)
	M_NavButton:(0,0,SSR_CustomGo,,)
	{
		Draw:(IAccept,30,25,90,90)
	}
		Delay(0.1)
		ConvergeFrom(640,0)
		Click(customcareer.btn_Ok)
		<
			PlaySnd(UISelect)
		>
PopOrigin
