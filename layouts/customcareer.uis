// The custom career: the age, the skills, the position, the first club,
// and the Bux of the player at the start. A screen of the remake. It comes
// after the choice of the nation, before the trials. The minus and the plus
// buttons change each value, and a tap on a value also goes up.

UnsortedLayer:(AfterGloss,1)

Import:(ButtonDefs.uis)
Import:(ButtonMacros.uis)
Import:(JDButtonDefs.uis)
Import:(JDButtonMacros.uis)

Rect:(0,0,0,0)
	ShowShell(Ticker,1)

M_Background:()
M_Footer:(OFF,,,)

// The ribbon at the top.
Rect:()
{
	M_Header:(-40,@T,ILife,32,36,88,198,14,YES)
}

// The top of the buttons at the bottom.
Set:(@n=[@B-960]*0.7+744)
// The top of the title. The title and the values (632 high) go in the
// middle between the ribbon and the buttons at the bottom. The value comes
// from a frame of the screen.
Set:(@m=[@n+156]*0.5-378)

// The title.
PushOrigin:(60,@m)
	Rect:(0,0,500,76)
	{
		Draw:(ButtonShadow,18,8,500,76,,#FFFFFF80)
		Draw:(GreenButton,10,0,500,76)
		Draw:(Glint,0,15.5,42,,,#606060FFFFFFFFFF)
			Handle(42,16)
			Shine(0,480)
			Additive()
		Text:(Start,20,0,480,72)
			FontSize(1)
			Layer(AfterGloss)
			StringReadout(Custom,Title)
	}
		ConvergeFrom(-640,0)
PopOrigin

PushOrigin:(13,@m+96)
	Rect:(0,0,614,100)
	{
		Draw:(GreyRecess,0,0,614,100)
		Text:(LABEL,10,2,594,38,C,,#BBDDBBFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.4,0.4)
			StringReadout(Custom,AgeLabel)
	}
		ConvergeFrom(-640,0)
PopOrigin
PushOrigin:(23,@m+134)
	Rect:(0,0,110,56)
	{
		Draw:(ButtonShadow,6,6,110,56,,#FFFFFF80)
		Draw:(GreenButton,0,0,110,56)
		Text:(-,0,0,110,52,C,,#FFFFFFFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.7,0.7)
	}
		Click(customcareer.btn_AgeDown)
		<
			PlaySnd(UISelect)
		>
		ConvergeFrom(-640,0)
PopOrigin
PushOrigin:(145,@m+134)
	Rect:(0,0,350,56)
	{
		Text:(00,0,0,350,52,C,,#FFFFFFFF)
			Layer(AfterGloss)
			FontSize(1)
			FontScale(0.5,0.5)
			GS_CustomAge()
	}
		Click(customcareer.btn_Age)
		<
			PlaySnd(UISelect)
		>
		ConvergeFrom(-640,0)
PopOrigin
