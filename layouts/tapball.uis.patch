# The import has no BallShadow image, so the tap ball had no shadow. The
# shadows use the soft shadow of the remake (SSRBallShadow). The app moves,
# scales, and fades the four night shadows as c_TapballShadowNighttime
# does.
- Draw:(BallShadow,-1000,925,200,50) ref:TapBallDayShadow
+ Draw:(SSRBallShadow,-1000,925,200,50) ref:TapBallDayShadow
- Draw:(BallShadow,0,0,200,50) ref:TapBallNightShadow
+ Draw:(SSRBallShadow,0,0,200,50) ref:TapBallNightShadow
